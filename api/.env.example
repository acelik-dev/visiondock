# Copy to api/.env and fill in. See https://learn.microsoft.com/azure/ai-services/openai/how-to/switching-endpoints
VLM_API_KEY=
# OpenAI-compatible base URL (include /openai/v1)
VLM_ENDPOINT=https://YOUR_RESOURCE_NAME.openai.azure.com/openai/v1
# Must match your Azure deployment name
VLM_MODEL=gpt-4.1-mini

# Langfuse observability (optional — traces VLM / OpenAI calls)
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_FLUSH_AT=1
# LANGFUSE_FLUSH_INTERVAL=0.5

# Login page auth (session cookie — no browser popup)
AUTH_ENABLED=true
AUTH_ALLOW_SIGNUP=true
AUTH_DB_USERS=true
AUTH_SESSION_DAYS=30
AUTH_USERNAME=admin@example.com
AUTH_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string
# Legacy alias still supported: AUTH_SESSION_SECRET

# Transactional email (signup welcome + verify link)
# Without SMTP, emails are captured/logged and stored in email_messages (status=captured).
# EMAIL_FROM=noreply@yourdomain.com
# EMAIL_FROM_NAME=VisionDock
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.xxx
# SMTP_STARTTLS=true
# Optional: SMTP_SSL=true for port 465
# PUBLIC_API_URL=https://your-api.azurewebsites.net
# FRONTEND_URL=https://your-frontend-or-same-origin

# Google OAuth (optional — enable social sign-in)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# FRONTEND_URL=http://localhost:8080

# Database
# Local: leave unset → SQLite under api/data/ (dev only)
# Azure: required — App Service refuses SQLite fallback
# DATABASE_URL=postgresql://user:pass@host.postgres.database.azure.com:5432/visiondock?sslmode=require
# Provision: RESOURCE_GROUP=visiondock-rg WEBAPP_NAME=visiondock-api-ataha ./scripts/azure-provision-postgres.sh

# Storage — local dev (no Azure cost)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data
AZURE_STORAGE_CONTAINER=visiondock

# Azure production (after scripts/azure-provision-minimal.sh)
# STORAGE_BACKEND=azure
# AZURE_STORAGE_CONNECTION_STRING=
# MAX_DATASET_ZIP_BYTES=536870912

# Azure ML training (after scripts/configure-azure-ml-access.sh)
# AZURE_SUBSCRIPTION_ID=
# AZURE_RESOURCE_GROUP=vision-doc
# AZURE_ML_WORKSPACE=visiondock-ml
# AZURE_ML_COMPUTE=gpu-cluster
# AZURE_ML_VM_SIZE=Standard_NC4as_T4_v3
# GPU env registered in workspace (do not use @latest curated names unless registered)
# AZURE_ML_ENVIRONMENT=azureml:AzureML-ACPT-pytorch-1.13-py38-cuda11.7-gpu:1
# Optional: Azure AD tenant id for ml.azure.com links (prevents redirect to Studio home)
# AZURE_ML_STUDIO_TENANT_ID=
# TRAINING_MOCK=0

# Legacy names still supported: BASIC_AUTH_USERNAME, BASIC_AUTH_PASSWORD
